{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^typecheck"]
    },
    "ci:lint": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "ci:test": {
      "dependsOn": ["^typecheck"]
    },
    "test:integration": {
      "dependsOn": ["^typecheck"],
      "env": ["PILOTE_IR_API_KEY"]
    },
    "ci:test:integration": {
      "dependsOn": ["^typecheck"],
      "env": ["PILOTE_IR_API_KEY"]
    },
    "format": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
